# ==============================================================================
# Configuración de Entorno — Attention Is All She Needs (AIASN)
# Reto «Mujeres por la IA Abierta» — Equipo 1
# ==============================================================================

# AI Endpoints de OVHcloud (Patrocinador Oficial del Reto)
# Obtén tu token en la plataforma de OVHcloud / Keppler AI
OVH_BASE_URL="https://oai.endpoints.kepler.ai.cloud.ovh.net/v1"
OVH_AI_ENDPOINTS_ACCESS_TOKEN="tu_token_aqui"

# Modelos recomendados en OVHcloud
OVH_ASR_MODEL="whisper-large-v3"

# Soberanía Lingüística Cooficial y Multilingüismo Nativo (ADR-0010 / Art. 157 Ley 40/2015)
AIASN_SUPPORTED_LANGUAGES="es,ca,gl,eu,en"

# Configuración del Motor Determinista
AIASN_ETHICAL_THRESHOLD=0.80
AIASN_EQUALITY_WASHING_PRESENCE_THRESHOLD=0.35
AIASN_EQUALITY_WASHING_RATIO_THRESHOLD=0.30

# ==============================================================================
# Demo (API + worker). Cualquier ajuste de aiasn/settings.py se puede dar aquí:
# los anidados con "__", p. ej. VIDEO__DEVICE=cpu o API__WORKER__GPU=false
# ==============================================================================

# Claves del almacén S3 (SeaweedFS) del docker compose
S3_ACCESS_KEY=aiasn
S3_SECRET_KEY=cambia_esta_clave

# Privacidad: el docker compose borra el vídeo subido y sus fotogramas al terminar de procesarlo.
# Pon false para conservarlos (depuración, vídeo anotado). Sin Docker, PRIVACY__DELETE_MEDIA_AFTER_RUN=true.
# DELETE_MEDIA_AFTER_RUN=true

# Puertos de la API y del front en tu equipo (si el 8000 o el 8080 están ocupados)
# API_PORT=8000
# FRONT_PORT=8080

# Sin Docker: dónde guardar el lake (carpeta local o s3://bucket) y los modelos
# LAKE_URI=data
# MODELS_DIR=models
