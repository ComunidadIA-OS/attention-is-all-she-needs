# ==============================================================================
# Configuración de Entorno — Attention Is All She Needs (AIASN)
# Reto «Mujeres por la IA Abierta» — Equipo 1
# ==============================================================================

# Token de OVHcloud AI Endpoints: transcripción (Whisper) y LLM
OVH_AI_ENDPOINTS_ACCESS_TOKEN="tu_token_aqui"

# Endpoint y modelo de la transcripción
# AUDIO__TRANSCRIBER__BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# AUDIO__TRANSCRIBER__MODEL=whisper-large-v3
# Idioma del audio: sin definir (None), Whisper lo detecta solo. Para fijarlo: es, ca, gl, eu, en...
# AUDIO__TRANSCRIBER__LANGUAGE=
# Idiomas del OCR de los rótulos
# VIDEO__OCR__LANGUAGES=["es","en"]

# Umbral ético: con menos confianza, el género queda como no_determinado (ADR-0005)
# SILVER__GENDER_THRESHOLD=0.80
# Los umbrales de equality-washing (35 % de pantalla, ratio 0,30, 20 % de voz) son fijos en aiasn/core/fusion.py

# ==============================================================================
# Demo (API + worker). Cualquier ajuste de aiasn/settings.py se puede dar aquí:
# los anidados con "__", p. ej. VIDEO__DEVICE=cpu o API__WORKER__GPU=false
# ==============================================================================

# Claves del almacén S3 (SeaweedFS) del docker compose
S3_ACCESS_KEY=aiasn
S3_SECRET_KEY=cambia_esta_clave

# Privacidad: el docker compose borra el vídeo subido y sus fotogramas al terminar de procesarlo.
# Pon false para conservarlos (depuración, vídeo anotado). Sin Docker, PRIVACY__DELETE_MEDIA_AFTER_RUN=true.
# DELETE_MEDIA_AFTER_RUN=true

# Imagen del worker: gpu (por defecto, ~12,5 GB, necesita GPU NVIDIA) o cpu (sin las librerías de CUDA, ~4,4 GB,
# para equipos sin GPU NVIDIA; mucho más lenta). Se aplica al construirla: docker compose --profile jobs build worker
# WORKER_DEVICE=gpu

# Puertos de la API y del front en tu equipo (si el 8000 o el 8080 están ocupados)
# API_PORT=8000
# FRONT_PORT=8080

# Sin Docker: dónde guardar el lake (carpeta local o s3://bucket) y los modelos
# LAKE_URI=data
# MODELS_DIR=models

# ==============================================================================
# Langfuse: trazas de las llamadas al LLM (docker compose --profile langfuse up -d)
# ==============================================================================

# true para enviar las trazas; con false (o sin el servidor) el análisis funciona igual, sin trazas
LANGFUSE_ENABLED=false
# Claves del proyecto: Langfuse lo crea al arrancar con estas mismas claves (pk-lf-... / sk-lf-...)
LANGFUSE_PUBLIC_KEY=pk-lf-cambia_esta_clave
LANGFUSE_SECRET_KEY=sk-lf-cambia_esta_clave
# Sin Docker: dónde está Langfuse (en Docker los workers usan http://langfuse-web:3000)
LANGFUSE_BASE_URL=http://localhost:3000
# Usuario de la interfaz web de Langfuse
LANGFUSE_INIT_USER_EMAIL=admin@aiasn.local
LANGFUSE_INIT_USER_PASSWORD=cambia_esta_clave
